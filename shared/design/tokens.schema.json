{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Teacher Studio design tokens (output of shared/design/design.py)",
 "type": "object",
 "required": ["version", "use", "palette", "colors", "fonts", "type", "motion", "sound"],
 "properties": {
  "version": {"const": 1},
  "use": {"enum": ["class", "personal", "present", "poster", "invite", "print", "web"]},
  "palette": {"type": "string"},
  "seed": {"type": "integer"},
  "colors": {
   "type": "object",
   "required": ["bg1", "bg2", "text", "card", "cardText", "cardBorder", "primary", "btnText", "accent", "good", "bad"],
   "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
  },
  "fonts": {"type": "object", "required": ["display", "body"], "properties": {"display": {"type": "string"}, "body": {"type": "string"}}},
  "type": {
   "type": "object",
   "required": ["title", "question", "choice", "body", "small", "floor"],
   "properties": {
    "title": {"type": "integer", "minimum": 40},
    "question": {"type": "integer", "minimum": 24},
    "choice": {"type": "integer", "minimum": 18},
    "body": {"type": "integer", "minimum": 16},
    "small": {"type": "integer", "minimum": 12},
    "floor": {"type": "object", "required": ["question", "choice", "body", "small", "button_h"]}
   }
  },
  "canvas": {"type": "string", "description": "reference canvas the type sizes are written for"},
  "motion": {"enum": ["high", "normal", "calm"]},
  "sound": {"type": "object", "required": ["sfx", "music"], "properties": {"sfx": {"type": "boolean"}, "music": {"type": "boolean"}}},
  "baseTheme": {"type": "string"},
  "bgType": {"type": "string"},
  "theme": {"type": "string", "description": "game theme module id (teacher-game assets/themes/)"},
  "contrast": {"type": "object", "description": "measured ratios, informational"}
 }
}
