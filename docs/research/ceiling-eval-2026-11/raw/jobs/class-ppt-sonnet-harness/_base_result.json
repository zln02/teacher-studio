8098317-2fbb-4131-bf8f-07218752ac6e\\scratchpad\\jobs\\class-ppt-sonnet-harness\\work\\빛의_반사와_굴절.pptx`\n\n**디자인:** 16:9, 맑은 고딕, 짙은 남색과 노랑 테마입니다. 제목은 34pt이고 본문은 20pt 이상입니다. 예외로 다이어그램의 '법선' 라벨 하나만 18pt입니다. 입사각·반사각·굴절각 도식은 도형으로 직접 그렸고, 모든 슬라이드에 교사용 발표자 노트가 들어 있습니다.\n\n**구성**\n1. 표지: 빛의 반사와 굴절\n2. 학습 목표와 오늘의 질문 (물컵 속 빨대)\n3. 빛의 직진과 물체가 보이는 원리\n4. 빛의 반사: 입사각과 반사각\n5. 반사 법칙과 두 가지 반사 (거울 반사와 난반사 비교)\n6. 반사의 활용 (평면거울, 잠망경, 볼록거울, 오목거울)\n7. 빛의 굴절과 속도 변화 (공기→물, 물→공기)\n8. 우리 주변의 굴절 현상 (물속 동전·빨대, 신기루, 렌즈, 무지개)\n9. 반사와 굴절 비교표\n10. 탐구 활동과 확인 문제 (O/X 2문항, 단답 1문항, 정답은 발표자 노트에)\n11. 정리 및 마무리 (핵심 3줄)\n\n굴절각은 근사값으로 그렸습니다. 공기→물은 입사각 50°에 굴절각 35°, 물→공기는 입사각 30°에 굴절각 42°입니다. 수치를 바꾸고 싶으면 말씀해 주세요.","ttft_ms":1678,"type":"result","duration_ms":214371,"uuid":"a8fbf3d8-d7d7-4ce2-93a5-f111d26eb208","ttft_stream_ms":860,"time_to_request_ms":246,"time_to_request_phases_ms":{"other":8,"system_prompt":22,"resume_other":1,"process_user_input":3,"input_attachments":45,"input_hooks":3,"conversation_append":0,"transcript_persist":18,"tool_pool_refresh":5,"init_message":46,"init_frame_send":15,"engine_pickup":3,"loop_entry":6,"message_prep":2,"model_config_wait":1,"autocompact":2,"request_announcements":12,"query_setup":1,"model_gates":1,"tool_schema_build":31,"message_normalization":5,"client_creation":5,"request_build":11},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":57,"time_to_request_cpu_ms":391,"time_to_request_major_faults":7616,"input_attachments_detail":{"slowest_producer":"deferred_tools_delta","slowest_producer_ms":26,"cpu_ms":95,"major_faults":2375,"setup_ms":6,"prompt_producers_ms":0,"ambient_start_ms":8,"ambient_wait_ms":26,"render_ms":2,"producers":44,"token_counts":0},"tool_schema_build_detail":{"betas_ms":1,"waits_ms":1,"placement_ms":3,"render_ms":25,"after_ms":1,"other_ms":0,"tools":15,"new_schemas":15},"message_normalization_detail":{"before_ms":0,"normalize_ms":3,"images_ms":0,"post_process_ms":1,"after_ms":0,"other_ms":1,"messages":13,"wire_m